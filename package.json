{
  "name": "zeouf-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run docs:check && eslint",
    "prebuild": "npm run docs:check",
    "docs:sync": "node scripts/requirements.mjs sync",
    "docs:check": "node scripts/requirements.mjs check",
    "docs:review": "node scripts/requirements.mjs review",
    "docs:watch": "node scripts/requirements.mjs watch",
    "docs:test": "node --test scripts/requirements.test.mjs",
    "test:ui": "playwright test",
    "test:catalog": "playwright test --config=playwright.catalog.config.ts",
    "test:live": "playwright test --config=playwright.live.config.ts",
    "seed:products": "node --env-file=.env.local migrate-products.js",
    "seed:admin-data": "node --env-file=.env.local scripts/seed_admin_data.js",
    "upload:images": "node upload-images.js",
    "local:up": "docker-compose up -d",
    "local:down": "docker-compose down",
    "seed:postgres": "node scripts/seed_postgres.js",
    "seed:orders": "node scripts/seed_orders.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "pg": "^8.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
