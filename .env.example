# Public Supabase settings. These are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only settings. Never expose or commit these values.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_CREDENTIALS={"owner":"scrypt:<32-hex-salt>:<128-hex-hash>"}
ADMIN_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-characters
RATE_LIMIT_SECRET=replace-with-another-random-secret-at-least-32-characters
# Nonproduction helper only; do not set in production.
DEV_CREATE_USER_KEY=replace-with-a-dev-only-secret
TEST_API_SECRET=replace-with-a-separate-test-only-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=your_resend_api_key
RESTOCK_FROM_EMAIL=store@example.com

# Optional: used by the local Postgres seed scripts and CI.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/els_ecommerce_local
